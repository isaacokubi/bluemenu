PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/bluemenu?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
# Temporary protection for initial admin API scaffolding; use a unique secret.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Required for JWT login sessions. Generate a long random value (32+ bytes).
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Safaricom Daraja (optional; use sandbox for testing)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Required only for CustomerBuyGoodsOnline transactions
DARAJA_TILL_NUMBER=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Must be a publicly reachable HTTPS URL pointing to /api/payments/daraja/callback
DARAJA_CALLBACK_URL=

# Cloudinary media storage (optional but recommended for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery for account recovery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=BlueMenu <no-reply@your-verified-domain.example>
APP_BASE_URL=http://localhost:5173

# Optional AI menu and meeting assistant
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Firebase Cloud Messaging HTTP v1 service account JSON (single-line JSON; never commit the real value)
FCM_SERVICE_ACCOUNT_JSON=
# Subscription renewal scheduler shared secret; configure a trusted external cron to call POST /api/subscriptions/renewals/run
CRON_SECRET=
# Android release signing (GitHub Actions repository secrets; do not put values in this file)
